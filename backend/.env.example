# Copy this file to .env and fill in your values for local development.
# On Render, set these in the "Environment" tab of your service dashboard instead.

# Comma-separated list of frontend origins allowed to connect
FRONTEND_ORIGINS=https://your-site.com,http://localhost:5173

# Password required for teacher actions (move pieces, set mode, etc.)
# Leave unset or empty for no password protection.
TEACHER_PASSWORD=your-secret-password
